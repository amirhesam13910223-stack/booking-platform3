# OPENAI_API_KEY=your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key
# ZARINPAL_MERCHANT_ID=your-zarinpal-merchant-id

# ─── App ────────────────────────────────────────────────
VITE_APP_NAME=AIHub
VITE_APP_URL=http://localhost:5173
